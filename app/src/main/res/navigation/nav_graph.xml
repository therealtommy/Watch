<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    app:startDestination="@id/mainFragment">

    <fragment
        android:id="@+id/mainFragment"
        android:name="com.example.watch.ui.main.MainFragment"
        android:label="Watchlist">
        <action
            android:id="@+id/action_main_to_add"
            app:destination="@id/addFragment" />
    </fragment>

    <fragment
        android:id="@+id/addFragment"
        android:name="com.example.watch.ui.add.AddFragment"
        android:label="Add Movie">
        <action
            android:id="@+id/action_add_to_search"
            app:destination="@id/searchFragment" />
    </fragment>

    <fragment
        android:id="@+id/searchFragment"
        android:name="com.example.watch.ui.search.SearchFragment"
        android:label="Search">
        <action
            android:id="@+id/action_search_to_add"
            app:destination="@id/addFragment" />
    </fragment>

</navigation>